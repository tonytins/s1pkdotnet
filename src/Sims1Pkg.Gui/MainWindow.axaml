<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Sims1Pkg.Gui.MainWindow"
        Title="Sims1Pkg" Width="800" Height="600">
    <Grid ColumnDefinitions="*,3*" RowDefinitions="*,Auto,Auto">
        <!-- Left Panel - File Browser -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="File Browser" FontSize="16" FontWeight="Bold"/>
            <TreeView x:Name="FileTree" Margin="0,10,0,0"/>
        </StackPanel>
        
        <!-- Right Panel - Content -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Sims1Pkg" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Package Management Utility" FontSize="14" Foreground="Gray"/>
            
            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" Spacing="10">
                <Button x:Name="ExtractButton" Content="Extract" HorizontalAlignment="Left" Width="120"/>
                <Button x:Name="CompressButton" Content="Compress" HorizontalAlignment="Left" Width="120"/>
                <Button x:Name="InspectButton" Content="Inspect" HorizontalAlignment="Left" Width="120"/>
            </StackPanel>
            
            <!-- Progress -->
            <ProgressBar x:Name="ProgressBar" Margin="0,20,0,0" IsIndeterminate="False"/>
            <TextBlock x:Name="StatusText" Margin="0,5,0,0"/>
            
            <!-- File List -->
            <ListBox x:Name="FileList" Margin="0,20,0,0" Height="300"/>
        </StackPanel>
        
        <!-- Status at bottom -->
        <TextBlock x:Name="ReadyText" Grid.Row="2" Grid.ColumnSpan="2" 
                   Margin="10" HorizontalAlignment="Left">Ready</TextBlock>
    </Grid>
</Window>
