<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Sims1Pkg.Gui.MainWindow"
        Title="Sims1Pkg" Width="800" Height="600">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Game Directory Info -->
        <Grid Row="0" ColumnDefinitions="*,Auto" Margin="10">
            <TextBlock x:Name="GameDirText" Grid.Column="0" Text="Game Directory: Detecting..." VerticalAlignment="Center"/>
            <Button x:Name="RefreshDirsButton" Grid.Column="1" Content="Refresh" Width="80" VerticalAlignment="Center"/>
        </Grid>
        
        <!-- Main Content -->
        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Sims1Pkg GUI" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Package Management Utility" FontSize="14" Foreground="Gray"/>
            <TextBlock Text="Game directory detection is working!" FontSize="12" Foreground="DarkGreen" Margin="0,20,0,0"/>
            <TextBlock Text="CLI is available for file operations." FontSize="12" Foreground="Gray"/>
            
            <!-- Progress -->
            <ProgressBar x:Name="ProgressBar" Margin="0,20,0,0" IsIndeterminate="False"/>
            <TextBlock x:Name="StatusText" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Status at bottom -->
        <TextBlock x:Name="ReadyText" Grid.Row="2" 
                   Margin="10" HorizontalAlignment="Left">Ready</TextBlock>
    </Grid>
</Window>
