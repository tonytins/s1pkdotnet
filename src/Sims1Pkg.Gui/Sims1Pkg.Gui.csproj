<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sims1Pkg</AssemblyName>
    <RootNamespace>Sims1Pkg.Gui</RootNamespace>
    <Description>Installs, manages, and makes S1PK packages of Sims 1 custom content.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Approved for the GUI, 2026-11-19, at Roundhouse's version. -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- Interface text in .cst tables. Approved 2026-11-19. -->
    <PackageReference Include="CSTNet" Version="2.1.200" />
  </ItemGroup>

  <ItemGroup>
    <!-- Comic Neue, in place of the Comic Sans the Maxis-era tools used. SIL Open Font License 1.1; see OFL.txt. -->
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <None Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses/ComicNeue-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- One folder of tables per language, beside the app. -->
    <None Include="uitext\**\*.cst" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sims1Pkg.Core\Sims1Pkg.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sims1Pkg.Gui.Tests" />
  </ItemGroup>

</Project>
